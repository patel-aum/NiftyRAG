# OpenAI – used for CHAT (gpt-4o etc.) and EMBEDDINGS (text-embedding-3-small). Required.
OPENAI_API_KEY=your_openai_api_key
# Optional: chat model (default: gpt-4o). Others: gpt-4.1-mini, gpt-4.1-nano, gpt-5-mini, gpt-5-nano, o4-mini
# OPENAI_CHAT_MODEL=gpt-4o

# DataStax Astra DB Serverless - create at https://astra.datastax.com/
ASTRA_DB_API_ENDPOINT=https://YOUR_DB_ID-YOUR_REGION.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=your_astra_token

# Nifty 50 data: Yahoo Finance (^NSEI + Nifty 50 stocks) is used by default – no API key.
# Optional: secure cron-triggered ingest (Vercel Cron calls GET /api/ingest daily at 6:00 UTC)
# CRON_SECRET=your_random_secret

# Optional: Alpha Vantage only for Cursor MCP (https://mcp.alphavantage.co/) – not used by the app
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key